{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "planSchemaVersion": {
      "type": "string",
      "const": "4.0"
    },
    "ownerId": {
      "default": "local-user",
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "default": "",
      "type": "string",
      "maxLength": 4000
    },
    "effectiveStartDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "mesocycle": {
      "type": "object",
      "properties": {
        "durationWeeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52
        },
        "weeklyStructure": {
          "minItems": 1,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dayOfWeek": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "templateIds": {
                "minItems": 1,
                "maxItems": 26,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "dayOfWeek",
              "templateIds"
            ],
            "additionalProperties": false
          }
        },
        "phases": {
          "minItems": 1,
          "maxItems": 52,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "phaseType": {
                "type": "string",
                "enum": [
                  "foundation",
                  "progression",
                  "deload",
                  "peak",
                  "test",
                  "recovery"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "startWeek": {
                "type": "integer",
                "minimum": 1,
                "maximum": 52
              },
              "endWeek": {
                "type": "integer",
                "minimum": 1,
                "maximum": 52
              },
              "focus": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "progression": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                }
              }
            },
            "required": [
              "id",
              "phaseType",
              "name",
              "startWeek",
              "endWeek",
              "focus",
              "progression"
            ],
            "additionalProperties": false
          }
        },
        "adjustmentRules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trigger": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "trigger",
              "action",
              "rationale"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "durationWeeks",
        "weeklyStructure",
        "phases",
        "adjustmentRules"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sourceAgent": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "skillVersion": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputSnapshotHash": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "planSchemaVersion",
    "ownerId",
    "title",
    "summary",
    "effectiveStartDate",
    "mesocycle",
    "revision",
    "sourceAgent",
    "model",
    "skillVersion",
    "inputSnapshotHash",
    "updatedAt"
  ],
  "additionalProperties": false
}
