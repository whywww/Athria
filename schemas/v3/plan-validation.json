{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable"
            ]
          },
          "enforcement": {
            "type": "string",
            "enum": [
              "blocker",
              "advisory",
              "info"
            ]
          },
          "reasonCode": {
            "type": "string"
          },
          "rulePackId": {
            "type": "string"
          },
          "ruleVersion": {
            "type": "string"
          },
          "subjectRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "missingFacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidenceLimit": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "required": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "observed": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "required",
                  "observed"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "enforcement",
          "reasonCode",
          "rulePackId",
          "ruleVersion",
          "subjectRefs",
          "evidence",
          "missingFacts",
          "confidenceLimit"
        ],
        "additionalProperties": false
      }
    },
    "dataGaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "subjectRef": {
            "type": "string"
          },
          "factPath": {
            "type": "string"
          },
          "requiredByRuleCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocking": {
            "type": "boolean"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "agent_infer",
              "user_confirm",
              "add_profile_data"
            ]
          }
        },
        "required": [
          "code",
          "subjectRef",
          "factPath",
          "requiredByRuleCodes",
          "blocking",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "validatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "inputHash": {
      "type": "string"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "hardChecksResolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hardChecksTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "movementFactsResolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "movementFactsTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "muscleFactsResolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "muscleFactsTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "equipmentFactsResolved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "equipmentFactsTotal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "hardChecksResolved",
        "hardChecksTotal",
        "movementFactsResolved",
        "movementFactsTotal",
        "muscleFactsResolved",
        "muscleFactsTotal",
        "equipmentFactsResolved",
        "equipmentFactsTotal"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "valid",
    "results",
    "dataGaps",
    "validatedAt",
    "inputHash",
    "coverage"
  ],
  "additionalProperties": false
}
