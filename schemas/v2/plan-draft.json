{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "default": "local-user",
      "type": "string"
    },
    "clientRequestId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "default": "",
      "type": "string",
      "maxLength": 4000
    },
    "mesocycle": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "durationWeeks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52
            },
            "weeklyStructure": {
              "minItems": 1,
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dayOfWeek": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "templateId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "dayOfWeek",
                  "templateId"
                ],
                "additionalProperties": false
              }
            },
            "sessionTemplates": {
              "minItems": 1,
              "maxItems": 26,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "pattern": "^[A-Z]$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "modality": {
                    "type": "string",
                    "enum": [
                      "strength",
                      "endurance",
                      "recovery",
                      "mixed",
                      "unknown"
                    ]
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "durationMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 240
                  },
                  "hard": {
                    "default": false,
                    "type": "boolean"
                  },
                  "notes": {
                    "default": "",
                    "type": "string",
                    "maxLength": 4000
                  },
                  "exercises": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "exerciseKey": {
                          "type": "string",
                          "minLength": 1
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sets": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 12
                        },
                        "repsMin": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "repsMax": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "targetRpe": {
                          "default": null,
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 1,
                              "maximum": 10
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "restSeconds": {
                          "default": 90,
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 600
                        },
                        "referenceLoad": {
                          "default": null,
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "referenceLoadUnit": {
                          "default": null,
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "kg",
                                "lb"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "notes": {
                          "default": "",
                          "type": "string",
                          "maxLength": 1000
                        }
                      },
                      "required": [
                        "exerciseKey",
                        "name",
                        "sets",
                        "repsMin",
                        "repsMax",
                        "targetRpe",
                        "restSeconds",
                        "referenceLoad",
                        "referenceLoadUnit",
                        "notes"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "label",
                  "name",
                  "modality",
                  "intent",
                  "durationMinutes",
                  "hard",
                  "notes",
                  "exercises"
                ],
                "additionalProperties": false
              }
            },
            "phases": {
              "minItems": 1,
              "maxItems": 52,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "startWeek": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 52
                  },
                  "endWeek": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 52
                  },
                  "focus": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "progression": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  }
                },
                "required": [
                  "id",
                  "name",
                  "startWeek",
                  "endWeek",
                  "focus",
                  "progression"
                ],
                "additionalProperties": false
              }
            },
            "adjustmentRules": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "trigger": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "trigger",
                  "action",
                  "rationale"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "durationWeeks",
            "weeklyStructure",
            "sessionTemplates",
            "phases",
            "adjustmentRules"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sessions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "modality": {
            "type": "string",
            "enum": [
              "strength",
              "endurance",
              "recovery",
              "mixed",
              "unknown"
            ]
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "startAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240
          },
          "hard": {
            "default": false,
            "type": "boolean"
          },
          "templateId": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "phaseId": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "exercises": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "exerciseKey": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "sets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "repsMin": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "repsMax": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "targetRpe": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 10
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "restSeconds": {
                  "default": 90,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 600
                },
                "referenceLoad": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "referenceLoadUnit": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "kg",
                        "lb"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "notes": {
                  "default": "",
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "exerciseKey",
                "name",
                "sets",
                "repsMin",
                "repsMax",
                "targetRpe",
                "restSeconds",
                "referenceLoad",
                "referenceLoadUnit",
                "notes"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "default": "",
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "name",
          "modality",
          "intent",
          "startAt",
          "durationMinutes",
          "hard",
          "templateId",
          "phaseId",
          "exercises",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "sourceAgent": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "skillVersion": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "inputSnapshotHash": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "ownerId",
    "clientRequestId",
    "title",
    "summary",
    "mesocycle",
    "sessions",
    "sourceAgent",
    "model",
    "skillVersion",
    "inputSnapshotHash",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
