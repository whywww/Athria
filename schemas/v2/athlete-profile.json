{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ownerId": {
      "default": "local-user",
      "type": "string"
    },
    "displayName": {
      "default": "Athlete",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "timezone": {
      "default": "Asia/Hong_Kong",
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "default": [
        "general_fitness"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "default": "balanced",
      "type": "string",
      "enum": [
        "strength",
        "endurance",
        "balanced"
      ]
    },
    "weeklyStrengthSessions": {
      "default": 2,
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "weeklyEnduranceSessions": {
      "default": 2,
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "maxSessionMinutes": {
      "default": 60,
      "type": "integer",
      "minimum": 15,
      "maximum": 240
    },
    "trainingDays": {
      "default": [],
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      },
      "uniqueItems": true
    },
    "equipment": {
      "default": [
        "bodyweight",
        "dumbbell",
        "cable",
        "machine"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excludedExercises": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explicitRecoveryHours": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 168
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "ownerId",
    "displayName",
    "timezone",
    "goals",
    "priority",
    "weeklyStrengthSessions",
    "weeklyEnduranceSessions",
    "maxSessionMinutes",
    "trainingDays",
    "equipment",
    "excludedExercises",
    "constraints",
    "explicitRecoveryHours"
  ],
  "additionalProperties": false
}
