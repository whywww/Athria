{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "default": "local-user",
      "type": "string"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "externalId": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "type": "string",
      "enum": [
        "strength",
        "endurance",
        "recovery",
        "mixed",
        "unknown"
      ]
    },
    "domains": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "strength",
          "endurance",
          "sport_skill",
          "mind_body",
          "recovery"
        ]
      }
    },
    "sport": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "startAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "endAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "default": "completed",
      "type": "string",
      "const": "completed"
    },
    "timezone": {
      "default": null,
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "plannedSessionId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "timePrecision": {
      "default": "exact",
      "type": "string",
      "enum": [
        "exact",
        "date_only"
      ]
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "externalId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "externalId"
        ],
        "additionalProperties": false
      }
    },
    "planMatch": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "plannedSessionId": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "enum": [
                "auto",
                "manual"
              ]
            }
          },
          "required": [
            "plannedSessionId",
            "method"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "isPlanMatchExcluded": {
      "default": false,
      "type": "boolean"
    },
    "strengthSets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "exerciseRaw": {
            "type": "string",
            "minLength": 1
          },
          "exerciseKey": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "movement": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "primaryMuscles": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "secondaryMuscles": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "setIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "setType": {
            "default": "normal",
            "type": "string"
          },
          "weight": {
            "default": null,
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "weightUnit": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "kg",
                  "lb"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "reps": {
            "default": null,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "rpe": {
            "default": null,
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "leftWeight": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "rightWeight": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "durationSeconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "restSeconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "plannedRestSeconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "exerciseRaw",
          "exerciseKey",
          "movement",
          "primaryMuscles",
          "secondaryMuscles",
          "setIndex",
          "setType",
          "weight",
          "weightUnit",
          "reps",
          "rpe"
        ],
        "additionalProperties": false
      }
    },
    "endurance": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "distanceMeters": {
              "default": null,
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "averageHeartRate": {
              "default": null,
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxHeartRate": {
              "default": null,
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "averagePowerWatts": {
              "default": null,
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxPowerWatts": {
              "default": null,
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "heartRateZoneSeconds": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "required": [
            "distanceMeters",
            "averageHeartRate",
            "maxHeartRate",
            "averagePowerWatts",
            "maxPowerWatts",
            "heartRateZoneSeconds"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "missingFields": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "ownerId",
    "source",
    "externalId",
    "modality",
    "domains",
    "sport",
    "name",
    "startAt",
    "endAt",
    "durationMinutes",
    "status",
    "timezone",
    "plannedSessionId",
    "timePrecision",
    "sources",
    "planMatch",
    "isPlanMatchExcluded",
    "strengthSets",
    "endurance",
    "missingFields"
  ],
  "additionalProperties": false
}
