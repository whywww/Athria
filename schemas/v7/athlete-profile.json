{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ownerId": {
      "default": "local-user",
      "type": "string"
    },
    "preferredName": {
      "default": "Athlete",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "gender": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "female",
            "male",
            "non_binary",
            "prefer_not_to_say"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "heightCm": {
      "default": null,
      "anyOf": [
        {
          "type": "number",
          "minimum": 50,
          "maximum": 250
        },
        {
          "type": "null"
        }
      ]
    },
    "birthDate": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "timezone": {
      "default": "Asia/Hong_Kong",
      "type": "string",
      "minLength": 1
    },
    "goals": {
      "default": [
        "general_fitness"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preference": {
      "default": "",
      "type": "string",
      "maxLength": 80
    },
    "maxSessionMinutes": {
      "default": 60,
      "type": "integer",
      "minimum": 15,
      "maximum": 240
    },
    "trainingRhythm": {
      "default": {
        "kind": "flexible_week",
        "targetDaysPerWeek": 4,
        "minDaysPerWeek": 3,
        "maxDaysPerWeek": 5
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fixed_week"
            },
            "days": {
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            }
          },
          "required": [
            "kind",
            "days"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "flexible_week"
            },
            "targetDaysPerWeek": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "minDaysPerWeek": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "maxDaysPerWeek": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          },
          "required": [
            "kind",
            "targetDaysPerWeek",
            "minDaysPerWeek",
            "maxDaysPerWeek"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "interval"
            },
            "intervalDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "required": [
            "kind",
            "intervalDays"
          ],
          "additionalProperties": false
        }
      ]
    },
    "equipment": {
      "default": [
        "dumbbell",
        "barbell",
        "kettlebell",
        "cable",
        "smith_machine",
        "machine",
        "landmine",
        "pull_up_bar",
        "trx",
        "bench",
        "plyo_box",
        "resistance_band",
        "medicine_ball",
        "sandbag",
        "sled",
        "treadmill",
        "exercise_bike",
        "rowing_machine",
        "elliptical",
        "stepper",
        "ski_erg",
        "jump_rope",
        "battle_rope",
        "yoga_mat",
        "foam_roller",
        "massage_ball",
        "reformer",
        "pilates_ring",
        "mini_stability_ball",
        "ball_machine"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dumbbell",
          "barbell",
          "kettlebell",
          "cable",
          "smith_machine",
          "machine",
          "landmine",
          "pull_up_bar",
          "trx",
          "bench",
          "plyo_box",
          "resistance_band",
          "medicine_ball",
          "sandbag",
          "sled",
          "treadmill",
          "exercise_bike",
          "rowing_machine",
          "elliptical",
          "stepper",
          "ski_erg",
          "jump_rope",
          "battle_rope",
          "yoga_mat",
          "foam_roller",
          "massage_ball",
          "reformer",
          "pilates_ring",
          "mini_stability_ball",
          "ball_machine"
        ]
      }
    },
    "injuries": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "constraintNotes": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "explicitRecoveryDays": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        {
          "type": "null"
        }
      ]
    },
    "unitSystem": {
      "default": "metric",
      "type": "string",
      "enum": [
        "metric",
        "imperial"
      ]
    },
    "mesocycleDurationWeeks": {
      "default": 8,
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "raceDays": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sport": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "date",
          "sport"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ownerId",
    "preferredName",
    "gender",
    "heightCm",
    "birthDate",
    "timezone",
    "goals",
    "preference",
    "maxSessionMinutes",
    "trainingRhythm",
    "equipment",
    "injuries",
    "constraintNotes",
    "explicitRecoveryDays",
    "unitSystem",
    "mesocycleDurationWeeks",
    "raceDays"
  ],
  "additionalProperties": false
}
