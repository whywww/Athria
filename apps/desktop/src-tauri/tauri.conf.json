{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athria",
  "version": "0.2.0",
  "identifier": "com.athria.desktop",
  "build": {
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Athria", "width": 1180, "height": 680, "minWidth": 1180, "minHeight": 680, "center": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
