{
  "name": "athria",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=24" },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @athria/desktop build",
    "check": "pnpm typecheck && pnpm test && pnpm validate:skill",
    "dev": "node scripts/desktop-build.mjs dev",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc -b",
    "build:debug": "node scripts/desktop-build.mjs debug",
    "build:app": "node scripts/desktop-build.mjs app",
    "release:native": "node scripts/desktop-build.mjs release",
    "release:msi": "node scripts/desktop-build.mjs msi",
    "build:desktop": "pnpm release:native",
    "validate:skill": "node scripts/validate-skills.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "yaml": "2.8.1"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-darwin-x64": "7.0.2",
    "@typescript/typescript-linux-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2",
    "@typescript/typescript-win32-arm64": "7.0.2",
    "@typescript/typescript-win32-x64": "7.0.2"
  }
}
